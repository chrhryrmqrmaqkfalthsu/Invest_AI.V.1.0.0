[Unit]
Description=KINGMAKER dashboard API server on port 8001
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/g3000kkw/kingmaker
Environment=PYTHONPATH=/home/g3000kkw/kingmaker
ExecStart=/home/g3000kkw/kingmaker/venv/bin/uvicorn api_server_candidate_only:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
StandardOutput=append:/home/g3000kkw/kingmaker/logs/api_server_candidate_only_8001_systemd.log
StandardError=append:/home/g3000kkw/kingmaker/logs/api_server_candidate_only_8001_systemd.err.log

[Install]
WantedBy=default.target
